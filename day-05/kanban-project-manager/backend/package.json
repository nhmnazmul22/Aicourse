{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy:frontend",
    "copy:frontend": "mkdir -p dist/frontend && cp -r ../frontend/out dist/frontend/out 2>/dev/null || true",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.8.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-session": "^1.18.1",
    "connect-mongo": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/express-session": "^1.18.1",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
